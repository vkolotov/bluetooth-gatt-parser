    <Field name="Threshold as Metabolic Equivalent">
      <Format>uint8</Format>
      <DecimalExponent>-1</DecimalExponent>
      <Unit>org.bluetooth.unit.metabolic_equivalent</Unit>
      <!-- REVIEW: unparsed presence condition -->
    </Field>
    <Field name="Threshold as Percentage of Maximum Heart Rate">
      <Format>uint8</Format>
      <Unit>org.bluetooth.unit.percentage</Unit>
      <!-- REVIEW: unparsed presence condition -->
    </Field>
    <Field name="Threshold as Heart Rate">
      <Format>uint8</Format>
      <Unit>org.bluetooth.unit.period.beats_per_minute</Unit>
      <!-- REVIEW: unparsed presence condition -->
    </Field>
  </Value>
</Characteristic>
