    <Field name="Field Selector">
      <Format>uint8</Format>
    </Field>
    <Field name="Threshold as Energy Expenditure per Hour">
      <Format>uint16</Format>
      <DecimalExponent>3</DecimalExponent>
      <Unit>org.bluetooth.unit.energy.joule</Unit>
      <!-- REVIEW: unparsed presence condition -->
