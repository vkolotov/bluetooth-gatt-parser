        </Bit>
      </BitField>
    </Field>
    <Field name="Cycle Count Designed Lifetime">
      <Format>uint16</Format>
      <Requirement>C0</Requirement>
    </Field>
    <Field name="Min Designed Operating Temperature">
      <Format>sint8</Format>
      <Unit>org.bluetooth.unit.thermodynamic_temperature.degree_celsius</Unit>
      <Requirement>C1</Requirement>
    </Field>
    <Field name="Max Designed Operating Temperature">
      <Format>sint8</Format>
      <Unit>org.bluetooth.unit.thermodynamic_temperature.degree_celsius</Unit>
