<?xml version="1.0" encoding="UTF-8"?>
<Characteristic xsi:noNamespaceSchemaLocation="http://schemas.bluetooth.org/Documents/characteristic.xsd"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                name="Battery Health Status" type="org.bluetooth.characteristic.battery_health_status" uuid="2BEA" approved="No">
  <Value>
    <Field name="Flags">
      <BitField>
        <Bit index="0" size="1" name="C0">
          <Enumerations>
            <Enumeration key="1" requires="C0"/>
          </Enumerations>
        </Bit>
        <Bit index="1" size="1" name="C1">
          <Enumerations>
            <Enumeration key="1" requires="C1"/>
          </Enumerations>
        </Bit>
        <Bit index="2" size="1" name="C2">
          <Enumerations>
            <Enumeration key="1" requires="C2"/>
          </Enumerations>
        </Bit>
        <Bit index="3" size="1" name="C3">
          <Enumerations>
            <Enumeration key="1" requires="C3"/>
          </Enumerations>
        </Bit>
      </BitField>
    </Field>
    <Field name="Battery Health Summary">
      <Format>uint8</Format>
      <Unit>org.bluetooth.unit.percentage</Unit>
      <Requirement>C0</Requirement>
    </Field>
    <Field name="Cycle Count">
      <Format>uint16</Format>
      <Requirement>C1</Requirement>
    </Field>
    <Field name="Current Temperature">
      <Format>sint8</Format>
      <Unit>org.bluetooth.unit.thermodynamic_temperature.degree_celsius</Unit>
      <Requirement>C2</Requirement>
    </Field>
    <Field name="Deep Discharge Count">
      <Format>uint16</Format>
      <Requirement>C3</Requirement>
    </Field>
  </Value>
</Characteristic>
